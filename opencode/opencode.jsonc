{
  "$schema": "https://opencode.ai/config.json",
  "server": {
    "port": 4096,
    "hostname": "127.0.0.1",
    "mdns": false
  },
  "default_agent": "◆ main",
  "model": "openai/gpt-5.6-sol",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "◆ main": {
      "description": "default agent — balanced intelligence and speed for general coding",
      "mode": "primary",
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "color": "primary"
    },
    "◈ design": {
      "description": "frontend and design work — use opus when you need top visual/ui capability",
      "mode": "primary",
      "model": "opencode/claude-opus-4-8",
      "color": "#E57035"
    },
    "◇ drive": {
      "description": "in-the-loop iteration — fast and cheap for high-frequency back-and-forth",
      "mode": "primary",
      "model": "opencode/grok-4.5",
      "color": "#FACC15"
    },
    "» fast": {
      "description": "maximum speed for simple tasks and quick iterations",
      "mode": "primary",
      "model": "opencode/kimi-k2.6",
      "color": "#32D97C"
    }
  }
}
